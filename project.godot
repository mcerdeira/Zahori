; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zahori"
config/description="s"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[audio]

buses/default_bus_layout="uid://c2n32bjjymc7y"

[autoload]

Global="*uid://vgjbrcqyc5gm"
Settings="*res://scripts/Settings.gd"
Sfx="*res://scripts/Sfx.gd"
Music="*res://scripts/Music.gd"
Pause="*res://scripts/Pause.gd"
DoorMaze="*res://scripts/DoorMaze.gd"
Heartbeat="*res://scripts/Heartbeat.gd"

[display]

window/size/viewport_width=576
window/size/viewport_height=324
window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="expand"

